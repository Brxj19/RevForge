FROM ghcr.io/astral-sh/uv:0.12.22 AS uv

FROM python:3.12-slim

# Mercurial comes only from backend/uv.lock (I38): the `hg` CLI and `import mercurial`
# must be the same pinned release. Do not add the distro `mercurial` package here.
# UV_PROJECT_ENVIRONMENT=/usr/local installs into the image's system interpreter, so the
# `hg` entry point lands at /usr/local/bin/hg and survives the compose bind mounts.
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/usr/local \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    REVFORGE_HG_EXECUTABLE=/usr/local/bin/hg

COPY --from=uv /uv /usr/local/bin/uv

# build-essential compiles Mercurial's C extensions from the locked sdist.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/README.md backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project --inexact

COPY backend/alembic.ini ./alembic.ini
COPY backend/alembic ./alembic
COPY backend/app ./app

RUN uv sync --frozen --no-dev --no-editable --inexact \
    && test "$(HGPLAIN=1 HGRCPATH= /usr/local/bin/hg version -T '{ver}')" \
        = "$(python -c 'from mercurial import util; print(util.version().decode())')"

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
