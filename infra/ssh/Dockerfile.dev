FROM ghcr.io/astral-sh/uv:0.12.22 AS uv

FROM python:3.12-slim

# Mercurial comes only from backend/uv.lock (I38); see infra/backend/Dockerfile.dev.
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/usr/local \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    REVFORGE_HG_EXECUTABLE=/usr/local/bin/hg

COPY --from=uv /uv /usr/local/bin/uv

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential openssh-server netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp/revforge-backend

COPY backend/README.md backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project --inexact

COPY backend/app ./app

RUN uv sync --frozen --no-dev --no-editable --inexact \
    && test "$(HGPLAIN=1 HGRCPATH= /usr/local/bin/hg version -T '{ver}')" \
        = "$(python -c 'from mercurial import util; print(util.version().decode())')"

RUN mkdir -p /var/run/sshd /srv/revforge-ssh /data/repositories /data/event-spool \
    && useradd --create-home --shell /bin/sh revforge-hg \
    && passwd -d revforge-hg

COPY infra/ssh/sshd_config.dev /etc/ssh/sshd_config_revforge
COPY infra/ssh/revforge-ssh-gateway.sh /usr/local/bin/revforge-ssh-gateway
COPY infra/ssh/start-sshd.sh /usr/local/bin/start-sshd.sh

RUN chmod 755 /usr/local/bin/revforge-ssh-gateway /usr/local/bin/start-sshd.sh

EXPOSE 2222

CMD ["/usr/local/bin/start-sshd.sh"]
