# MSW mocks: set to 1 to run against mock data with no backend needed.
# The dev:mock script sets this automatically.
VITE_MOCKS=0

# Override the API origin (default: same-origin /api proxy via Vite).
# Only needed when the backend runs on a different host/port and you
# can't use the proxy (e.g. mobile testing on a LAN IP).
# VITE_API_BASE_URL=http://192.168.1.42:8000
