REVFORGE_ENVIRONMENT=development
REVFORGE_DEBUG=true
REVFORGE_LOG_LEVEL=INFO
REVFORGE_API_V1_PREFIX=/api/v1
REVFORGE_DATABASE_URL=postgresql+asyncpg://revforge:revforge@localhost:5432/revforge
REVFORGE_REDIS_URL=redis://localhost:6379/0
REVFORGE_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REVFORGE_SQLALCHEMY_ECHO=false
REVFORGE_SESSION_SECRET_KEY=change-me-in-local-env
REVFORGE_SESSION_COOKIE_NAME=revforge_session
REVFORGE_CSRF_COOKIE_NAME=revforge_csrf
REVFORGE_SESSION_COOKIE_SECURE=false
REVFORGE_SESSION_COOKIE_HTTPONLY=true
REVFORGE_SESSION_COOKIE_SAMESITE=lax
REVFORGE_SESSION_COOKIE_DOMAIN=
REVFORGE_SESSION_TTL_MINUTES=1440
REVFORGE_PASSWORD_MIN_LENGTH=12
REVFORGE_REPOSITORY_ROOT=./.local/repositories
REVFORGE_HG_EXECUTABLE=hg
REVFORGE_HG_COMMAND_TIMEOUT_SECONDS=15
REVFORGE_HG_MAX_STDOUT_BYTES=524288
REVFORGE_HG_MAX_STDERR_BYTES=65536
REVFORGE_MAX_DIFF_BYTES=262144
REVFORGE_MAX_FILE_CONTENT_BYTES=131072
REVFORGE_MAX_HISTORY_PAGE_SIZE=50
